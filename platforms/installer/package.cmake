cmake_minimum_required(VERSION 3.22)
if(NOT ROOT OR NOT PACKAGE_FILE OR NOT EXISTS "${PACKAGE_FILE}" OR NOT EXISTS "${PACKAGE_FILE}.sha256")
    message(FATAL_ERROR "Pass ROOT and a checked Qt6 PACKAGE_FILE with its .sha256 sidecar.")
endif()
file(SHA256 "${PACKAGE_FILE}" actual)
file(READ "${PACKAGE_FILE}.sha256" recorded)
string(SUBSTRING "${recorded}" 0 64 expected)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Qt6 package checksum does not match its sidecar")
endif()
set(output "${ROOT}/build/installer")
set(stage "${output}/ROREADER-Windows-Installer")
file(MAKE_DIRECTORY "${stage}/platforms/installer")
file(MAKE_DIRECTORY "${stage}/assets")
configure_file("${ROOT}/assets/roreader-icon.png" "${stage}/assets/roreader-icon.png" COPYONLY)
file(COPY "${ROOT}/Install-ROREADER.bat" "${ROOT}/Start-Installer.ps1" DESTINATION "${stage}")
file(COPY "${ROOT}/assets/translations" DESTINATION "${stage}/assets")
foreach(name index.html style.css app.js zip.js locale.js)
    configure_file("${ROOT}/platforms/installer/${name}" "${stage}/platforms/installer/${name}" COPYONLY)
endforeach()
configure_file("${PACKAGE_FILE}" "${stage}/ROREADER-qt6.zip" COPYONLY)
file(WRITE "${stage}/ROREADER-qt6.zip.sha256" "${actual}  ROREADER-qt6.zip\n")
file(WRITE "${stage}/LIESMICH.txt" "ROREADER: ZIP auf Windows entpacken, Install-ROREADER.bat starten. Chrome muss installiert sein. Reader per USB verbinden und sein Hauptverzeichnis auswaehlen. Daten vorher sichern. Nur kompatible Kobo/tolino-Geraete mit Firmware 5.x/6.x; keine Garantie fuer alle Modelle. Nach erfolgreichem Kopieren sicher auswerfen und USB trennen.\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${output}/ROREADER-Windows-Installer.zip" --format=zip ROREADER-Windows-Installer
    WORKING_DIRECTORY "${output}" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${output}/ROREADER-Windows-Installer.zip" installer_sha)
file(WRITE "${output}/ROREADER-Windows-Installer.zip.sha256" "${installer_sha}  ROREADER-Windows-Installer.zip\n")
message(STATUS "Windows installer: ${output}/ROREADER-Windows-Installer.zip")
